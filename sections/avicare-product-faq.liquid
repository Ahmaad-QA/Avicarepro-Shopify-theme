{%- capture faq_markup -%}
  {%- for block in section.blocks -%}
    {%- assign answer_text = block.settings.answer | strip_html | strip -%}
    {%- if block.settings.question != blank and answer_text != blank -%}
      {%- capture faq_children -%}
        <details
          class="details"
          data-testid="accordion-details"
          {% if block.settings.open_by_default %}
            open
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="details__header">
            <span class="avicare-product-faq__question">{{ block.settings.question | escape }}</span>
            <span class="svg-wrapper icon-plus" aria-hidden="true">
              {{- 'icon-plus.svg' | inline_asset_content -}}
            </span>
          </summary>

          <div class="details-content">
            <div class="avicare-product-faq__answer rte">
              {{ block.settings.answer }}
            </div>
          </div>
        </details>
      {%- endcapture -%}

      {% render 'accordion-custom-component',
        children: faq_children,
        open: block.settings.open_by_default,
        open_by_default_on_desktop: block.settings.open_by_default,
        open_by_default_on_mobile: block.settings.open_by_default
      %}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<section
  class="avicare-product-faq section section--page-width"
  {% if section.settings.heading != blank %}
    aria-labelledby="AvicareProductFaqHeading-{{ section.id }}"
  {% endif %}
>
  <div class="avicare-product-faq__inner">
    <div class="avicare-product-faq__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="avicare-product-faq__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 id="AvicareProductFaqHeading-{{ section.id }}" class="avicare-product-faq__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="avicare-product-faq__body rte">{{ section.settings.body }}</div>
      {% endif %}
    </div>

    {%- assign faq_markup = faq_markup | strip -%}
    {%- if faq_markup != blank -%}
      <div
        class="accordion accordion--plus accordion--dividers avicare-product-faq__accordion"
        style="
          --summary-font-family: var(--avicare-font-heading);
          --summary-font-style: normal;
          --summary-font-weight: 700;
          --summary-font-size: var(--font-h6--size);
          --summary-font-line-height: var(--font-h6--line-height);
          --summary-font-case: none;
          --style-border-width: 1px;
          --color-border: var(--avicare-border);
        "
      >
        {{ faq_markup }}
      </div>
    {%- endif -%}
  </div>
</section>

{% render 'accordion-styles' %}

{% stylesheet %}
  .avicare-product-faq {
    padding-block: var(--avicare-space-8);
    color: var(--avicare-text);
    text-align: start;
  }

  .avicare-product-faq__inner {
    max-inline-size: 52rem;
    margin-inline: auto;
  }

  .avicare-product-faq__intro {
    margin-block-end: var(--avicare-space-6);
  }

  .avicare-product-faq__eyebrow {
    margin: 0;
    margin-block-end: var(--avicare-space-3);
    color: var(--avicare-primary);
    font-family: var(--avicare-font-accent);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .avicare-product-faq__heading {
    margin: 0;
    color: var(--avicare-primary);
    font-family: var(--avicare-font-heading);
  }

  .avicare-product-faq__body {
    margin-block-start: var(--avicare-space-4);
    color: var(--avicare-muted-text);
    font-family: var(--avicare-font-body);
  }

  .avicare-product-faq__accordion {
    overflow: hidden;
    border: 1px solid var(--avicare-border);
    border-radius: var(--avicare-radius-md);
    background: var(--avicare-surface);
  }

  .avicare-product-faq__accordion accordion-custom {
    display: block;
  }

  .avicare-product-faq__accordion .details__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--avicare-space-4);
    padding: var(--avicare-space-4) var(--avicare-space-5);
    color: var(--avicare-primary);
    cursor: pointer;
  }

  .avicare-product-faq__accordion .details__header:focus-visible {
    outline: 2px solid var(--avicare-accent);
    outline-offset: -2px;
  }

  .avicare-product-faq__question {
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  .avicare-product-faq__accordion .icon-plus {
    flex: 0 0 auto;
  }

  .avicare-product-faq__accordion details[open] .icon-plus {
    transform: rotate(45deg);
  }

  .avicare-product-faq__accordion .details-content {
    padding-inline: var(--avicare-space-5);
    padding-block-end: 0;
  }

  .avicare-product-faq__answer {
    padding-block-end: var(--avicare-space-5);
    color: var(--avicare-muted-text);
    font-family: var(--avicare-font-body);
    overflow-wrap: anywhere;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AVICARE Product FAQ",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Product questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Find clear answers about this product’s intended nutritional support, use, and compatibility.</p>"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Product question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Add an approved product answer through the Theme Editor.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "AVICARE Product FAQ",
      "category": "Product",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "What is this product designed to support?",
            "answer": "<p>Add the approved product purpose and nutritional support information shown on the product label or official product content.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How should this product be used?",
            "answer": "<p>Follow the exact usage instructions shown on the approved product label. Do not estimate or generalize administration instructions.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can this product be used with other AVICARE PRO formulas?",
            "answer": "<p>Use products together only when the individual instructions or an approved care program indicate that they are compatible.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Is this product suitable for young pigeons?",
            "answer": "<p>Suitability depends on the individual formula, age guidance, and dosage instructions shown on the product label.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Where can I find the exact dosage?",
            "answer": "<p>The exact dosage must be taken from the approved product label or connected product guidance. Do not infer dosage from package size or product format.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Does this product treat disease?",
            "answer": "<p>AVICARE PRO products are nutritional support products and are not a substitute for professional veterinary diagnosis or treatment.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
