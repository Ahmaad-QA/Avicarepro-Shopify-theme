

{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  <announcement-bar-component
    class="announcement-bar__slider"
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="polite"
    {% endif %}
  >
    {% if show_arrows %}
      {% render 'slideshow-arrows', icon_style: 'chevron' %}
    {% endif %}

    <div class="announcement-bar__slides">
      {% content_for 'blocks' %}
    </div>
  </announcement-bar-component>
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
    background: linear-gradient(135deg, rgb(var(--avicare-primary-rgb, 15 77 58) / 0.98), rgb(var(--avicare-primary-rgb, 15 77 58) / 0.9));
    color: var(--color-background);
    box-shadow: inset 0 -1px 0 rgb(255 255 255 / 0.12);
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;
    min-block-size: clamp(2.75rem, 3.5vw, 3.5rem);

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: 760px;
    margin-inline: auto;
    padding-inline: var(--avicare-space-4);
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: 100%;
    padding-block: var(--avicare-space-2);
    padding-inline: var(--avicare-space-3);
    border-radius: var(--avicare-radius-pill);
    transition: opacity var(--avicare-transition-base), visibility var(--avicare-transition-base), transform var(--avicare-transition-base);
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
      transform: translateY(2px);
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-background);
    background: rgb(255 255 255 / 0.14);
    border-radius: 50%;
    backdrop-filter: blur(4px);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;
    transition: background-color var(--avicare-transition-base), transform var(--avicare-transition-base);

    &:hover {
      background-color: rgb(255 255 255 / 0.24);
      transform: scale(1.03);
    }

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__text {
    margin: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--avicare-space-2);
    text-align: start;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.25;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }

  .announcement-bar__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--avicare-accent);
  }

  .announcement-bar__meta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--avicare-space-2);
    flex-wrap: wrap;
  }

  .announcement-bar__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--avicare-space-3);
    padding-block: var(--avicare-space-1);
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: var(--avicare-radius-pill);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--avicare-transition-base), border-color var(--avicare-transition-base), transform var(--avicare-transition-base);

    &:hover {
      background-color: rgb(255 255 255 / 0.16);
      border-color: rgb(255 255 255 / 0.6);
      transform: translateY(-1px);
    }
  }

  @media screen and (max-width: 749px) {
    .announcement-bar__slide {
      padding-inline: var(--avicare-space-2);
    }

    .announcement-bar__text {
      font-size: 0.95rem;
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
