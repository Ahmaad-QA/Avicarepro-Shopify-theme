{% liquid
  assign image_alt = section.settings.image.alt | default: ''
  assign image_focal_point = section.settings.image.presentation.focal_point | default: 'center'
  assign image_style = 'object-position: ' | append: image_focal_point | append: ';'
  assign has_primary_cta = false
  assign has_secondary_cta = false

  if section.settings.image_alt != blank
    assign image_alt = section.settings.image_alt
  endif

  if section.settings.primary_label != blank and section.settings.primary_link != blank
    assign has_primary_cta = true
  endif

  if section.settings.secondary_label != blank and section.settings.secondary_link != blank
    assign has_secondary_cta = true
  endif
%}

<section
  class="avicare-science-trust section section--page-width"
  {% if section.settings.heading != blank %}
    aria-labelledby="AvicareScienceTrustHeading-{{ section.id }}"
  {% endif %}
>
  <div class="avicare-science-trust__surface">
    <div class="avicare-science-trust__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image
          | image_url: width: 2000
          | image_tag:
            widths: '375, 550, 750, 1100, 1500, 2000',
            sizes: '(min-width: 750px) 50vw, 100vw',
            class: 'avicare-science-trust__image',
            loading: 'lazy',
            alt: image_alt,
            style: image_style
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'avicare-science-trust__placeholder' }}
      {% endif %}
    </div>

    <div class="avicare-science-trust__content">
      {% if section.settings.eyebrow != blank %}
        <p class="avicare-science-trust__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 id="AvicareScienceTrustHeading-{{ section.id }}" class="avicare-science-trust__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="avicare-science-trust__body rte">{{ section.settings.body }}</div>
      {% endif %}

      {% if section.settings.trust_statement != blank %}
        <p class="avicare-science-trust__statement">{{ section.settings.trust_statement | escape }}</p>
      {% endif %}

      {% if section.settings.trust_point_1 != blank or section.settings.trust_point_2 != blank or section.settings.trust_point_3 != blank %}
        <ul class="avicare-science-trust__points" role="list">
          {% if section.settings.trust_point_1 != blank %}
            <li>{{ section.settings.trust_point_1 | escape }}</li>
          {% endif %}
          {% if section.settings.trust_point_2 != blank %}
            <li>{{ section.settings.trust_point_2 | escape }}</li>
          {% endif %}
          {% if section.settings.trust_point_3 != blank %}
            <li>{{ section.settings.trust_point_3 | escape }}</li>
          {% endif %}
        </ul>
      {% endif %}

      {% if has_primary_cta or has_secondary_cta %}
        <div class="avicare-science-trust__actions">
          {% if has_primary_cta %}
            <a class="button" href="{{ section.settings.primary_link }}">
              {{ section.settings.primary_label | escape }}
            </a>
          {% endif %}

          {% if has_secondary_cta %}
            <a class="button button-secondary" href="{{ section.settings.secondary_link }}">
              {{ section.settings.secondary_label | escape }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .avicare-science-trust {
    padding-block: var(--avicare-space-8);
    color: var(--avicare-text);
    text-align: start;
  }

  .avicare-science-trust__surface {
    display: grid;
    grid-template-areas: 'media' 'content';
    overflow: hidden;
    border: 1px solid var(--avicare-border);
    border-block-start: 3px solid var(--avicare-accent);
    border-radius: var(--avicare-radius-lg);
    background: var(--avicare-surface);
    box-shadow: var(--avicare-shadow-md);
  }

  .avicare-science-trust__media {
    grid-area: media;
    min-inline-size: 0;
    aspect-ratio: 4 / 3;
    background: var(--avicare-background);
  }

  .avicare-science-trust__image,
  .avicare-science-trust__placeholder {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .avicare-science-trust__image {
    object-fit: cover;
    object-position: center;
  }

  .avicare-science-trust__placeholder {
    object-fit: cover;
  }

  .avicare-science-trust__content {
    grid-area: content;
    align-self: center;
    min-inline-size: 0;
    max-inline-size: 42rem;
    padding: var(--avicare-space-6);
  }

  .avicare-science-trust__eyebrow {
    margin: 0 0 var(--avicare-space-3);
    color: var(--avicare-primary);
    font-family: var(--avicare-font-accent);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .avicare-science-trust__heading {
    margin: 0;
    color: var(--avicare-primary);
    font-family: var(--avicare-font-heading);
  }

  .avicare-science-trust__body {
    margin-block-start: var(--avicare-space-4);
    color: var(--avicare-muted-text);
    font-family: var(--avicare-font-body);
  }

  .avicare-science-trust__statement {
    margin: var(--avicare-space-5) 0 0;
    color: var(--avicare-text);
    font-weight: 700;
  }

  .avicare-science-trust__points {
    display: grid;
    gap: var(--avicare-space-2);
    margin: var(--avicare-space-5) 0 0;
    padding-inline-start: var(--avicare-space-5);
    color: var(--avicare-muted-text);
  }

  .avicare-science-trust__points li::marker {
    color: var(--avicare-accent);
  }

  .avicare-science-trust__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--avicare-space-3);
    margin-block-start: var(--avicare-space-6);
  }

  @media screen and (min-width: 750px) {
    .avicare-science-trust__surface {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'content media';
    }

    .avicare-science-trust__media {
      min-block-size: 32rem;
      aspect-ratio: auto;
    }

    .avicare-science-trust__content {
      padding: var(--avicare-space-7);
    }

    .avicare-science-trust__actions {
      flex-flow: row wrap;
      align-items: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AVICARE Science & Trust",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Leave blank to use the image's alt text."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The science behind AVICARE PRO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Veterinary-inspired support for every stage"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Our formulas are developed around targeted nutritional principles to support racing performance, recovery, breeding condition, respiratory wellness, and everyday vitality.</p>"
    },
    {
      "type": "textarea",
      "id": "trust_statement",
      "label": "Trust statement",
      "default": "Clear purpose. Carefully selected ingredients. Consistent quality."
    },
    {
      "type": "header",
      "content": "Trust points"
    },
    {
      "type": "text",
      "id": "trust_point_1",
      "label": "Trust point 1",
      "default": "Targeted nutritional support"
    },
    {
      "type": "text",
      "id": "trust_point_2",
      "label": "Trust point 2",
      "default": "Carefully selected ingredients"
    },
    {
      "type": "text",
      "id": "trust_point_3",
      "label": "Trust point 3",
      "default": "Consistent quality standards"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Explore our science"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "View products"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "AVICARE Science & Trust",
      "category": "Storytelling"
    }
  ]
}
{% endschema %}
