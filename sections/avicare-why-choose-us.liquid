<section
  class="avicare-why-choose-us section section--page-width"
  {% if section.settings.heading != blank %}
    aria-labelledby="AvicareWhyChooseUsHeading-{{ section.id }}"
  {% endif %}
>
  <div class="avicare-why-choose-us__intro">
    {% if section.settings.eyebrow != blank %}
      <p class="avicare-why-choose-us__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 id="AvicareWhyChooseUsHeading-{{ section.id }}" class="avicare-why-choose-us__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    {% if section.settings.body != blank %}
      <div class="avicare-why-choose-us__body rte">{{ section.settings.body }}</div>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <div class="avicare-why-choose-us__grid">
      {% for block in section.blocks %}
        <article class="avicare-why-choose-us__card" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <h3 class="avicare-why-choose-us__card-heading">{{ block.settings.heading | escape }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p class="avicare-why-choose-us__card-text">{{ block.settings.text | escape }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .avicare-why-choose-us {
    padding-block: var(--avicare-space-8);
    color: var(--avicare-text);
    text-align: start;
  }

  .avicare-why-choose-us__intro {
    max-inline-size: 52rem;
    margin-block-end: var(--avicare-space-7);
  }

  .avicare-why-choose-us__eyebrow {
    margin: 0 0 var(--avicare-space-3);
    color: var(--avicare-primary);
    font-family: var(--avicare-font-accent);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .avicare-why-choose-us__heading {
    margin: 0;
    color: var(--avicare-primary);
    font-family: var(--avicare-font-heading);
  }

  .avicare-why-choose-us__body {
    margin-block-start: var(--avicare-space-4);
    color: var(--avicare-muted-text);
    font-family: var(--avicare-font-body);
  }

  .avicare-why-choose-us__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--avicare-space-5);
    inline-size: 100%;
  }

  .avicare-why-choose-us__card {
    min-inline-size: 0;
    padding: var(--avicare-space-5);
    border: 1px solid var(--avicare-border);
    border-radius: var(--avicare-radius-md);
    background: var(--avicare-surface);
    box-shadow: var(--avicare-shadow-sm);
  }

  .avicare-why-choose-us__card-heading {
    margin: 0;
    color: var(--avicare-primary);
    font-family: var(--avicare-font-heading);
  }

  .avicare-why-choose-us__card-text {
    margin: var(--avicare-space-3) 0 0;
    color: var(--avicare-muted-text);
    font-family: var(--avicare-font-body);
  }

  @media screen and (min-width: 750px) {
    .avicare-why-choose-us__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .avicare-why-choose-us__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AVICARE Why Choose Us",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why AVICARE PRO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted veterinary-inspired nutrition"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Developed to support racing pigeons with premium formulations focused on performance, recovery, breeding, respiratory health, and long-term condition.</p>"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Feature description."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "AVICARE Why Choose Us",
      "category": "Storytelling",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "heading": "Veterinary-inspired",
            "text": "Formulated using science-driven nutritional principles."
          }
        },
        {
          "type": "feature",
          "settings": {
            "heading": "Premium ingredients",
            "text": "High-quality ingredients selected for consistency."
          }
        },
        {
          "type": "feature",
          "settings": {
            "heading": "Performance focused",
            "text": "Designed to support racing and breeding success."
          }
        },
        {
          "type": "feature",
          "settings": {
            "heading": "Trusted quality",
            "text": "Produced with strict quality standards."
          }
        }
      ]
    }
  ]
}
{% endschema %}
